# Supabase Public API Configuration for Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Development uses Vite's local proxy. For production, set this to the public
# backend URL, for example: https://api.your-domain.com/api/v1
VITE_API_URL=/api/v1
